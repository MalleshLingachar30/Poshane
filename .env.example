COMMAND_CENTER_ADMIN_EMAIL=ml@example.gov.in
COMMAND_CENTER_ADMIN_NAME=Super Admin
COMMAND_CENTER_ADMIN_PASSWORD_SALT=replace-with-random-hex-salt
COMMAND_CENTER_ADMIN_PASSWORD_HASH=replace-with-pbkdf2-sha256-password-hash
COMMAND_CENTER_ADMIN_PASSWORD_ITERATIONS=210000
COMMAND_CENTER_SESSION_SECRET=replace-with-strong-random-session-secret

# Server-only. Never expose this through NEXT_PUBLIC_* variables.
OPENAI_API_KEY=sk-proj-replace-with-server-side-key

# Poshane Mitra Realtime configuration.
POSHANE_MITRA_REALTIME_MODEL=gpt-realtime-2.1
POSHANE_MITRA_VOICE=cedar
POSHANE_MITRA_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
POSHANE_MITRA_REASONING_EFFORT=low
POSHANE_MITRA_VAD_EAGERNESS=low
POSHANE_MITRA_MAX_OUTPUT_TOKENS=800
